<scroll-view scroll-y="true" style="height: 100vh" bindscroll="onScroll">
  <view class="waterfall-container">
    <view class="column">
      <!-- Top placeholder (unchanged) -->
      <view
        class="placeholder"
        style="height: {{leftPlaceholderHeight}}px;"
      ></view>

      <!-- Visible items (unchanged) -->
      <view
        wx:for="{{visibleLeftData}}"
        wx:key="id"
        style="height: {{item.displayHeight}}px;display: flex;flex-direction: column;"
      >
        <image
          src="{{item.imageUrl}}"
          style="width: 100%;height:{{item.displayHeight-5}}px;"
          mode="widthFix"
        />
        <view style="width: 100%; height: 5px; background-color: #fff"></view>
      </view>

      <!-- NEW: Bottom placeholder -->
      <view
        class="placeholder"
        style="height: {{leftBottomPlaceholderHeight}}px;"
      ></view>
    </view>

    <view style="width: {{gapInRpx}}rpx"></view>

    <view class="column">
      <!-- Top placeholder (unchanged) -->
      <view
        class="placeholder"
        style="height: {{rightPlaceholderHeight}}px;"
      ></view>

      <!-- Visible items (unchanged) -->
      <view
        wx:for="{{visibleRightData}}"
        wx:key="id"
        style="height: {{item.displayHeight}}px;display: flex;flex-direction: column;"
      >
        <image
          src="{{item.imageUrl}}"
          style="width: 100%;height:{{item.displayHeight-5}}px;"
          mode="widthFix"
        />
        <view style="width: 100%; height: 5px; background-color: #fff"></view>
      </view>

      <!-- NEW: Bottom placeholder -->
      <view
        class="placeholder"
        style="height: {{rightBottomPlaceholderHeight}}px;"
      ></view>
    </view>
  </view>
</scroll-view>
